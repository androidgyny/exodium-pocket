{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exodium",
  "version": "0.7.4",
  "identifier": "com.redfox.exodium",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Exodium",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; frame-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; font-src 'self' data:",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: asset: http://asset.localhost ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$RESOURCE/**", "$APPDATA/**"]
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2OTFFQjE5QkMyN0VBQjkKUldTNTZpZThHZXVSbHJZNnBpeHF1T1NQdFJXT0ZRRFBPbmhKOWt1Y1cwMllUSG83aHlyd0NzQ1gK",
      "endpoints": [
        "https://github.com/tvollstaedt/exodium/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/dosbox-staging"
    ],
    "resources": {
      "../metadata": "metadata",
      "../torrents": "torrents",
      "../manifest.json": "manifest.json",
      "resources/previews/eXoDOS": "previews/eXoDOS",
      "resources/dosbox-glshaders": "dosbox-glshaders",
      "resources/dosbox-bin": "dosbox-bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
